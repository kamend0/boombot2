# Discord
DISCORD_TOKEN=your-bot-token-here
# Optional: restrict slash command sync to a single guild for instant updates.
# Leave empty to sync globally (takes up to 1hr to propagate).
DISCORD_GUILD_ID=

# Channel name (not ID) where keyword-triggered sounds are allowed.
TRIGGER_CHANNEL_NAME=boom-bot

# AWS / S3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_BUCKET=your-bucket
S3_ALIASES_KEY=boombot/aliases.json

# Logging
LOG_LEVEL=INFO
LOG_DIR=./logs
SOUNDS_DIR=./sounds
